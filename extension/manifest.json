{
  "manifest_version": 3,
  "name": "Calendar Hours",
  "version": "0.2.9",
  "description": "Add calculated hours or minutes to Google Calendar event titles.",
  "permissions": ["storage", "identity"],
  "host_permissions": ["https://www.googleapis.com/*", "https://oauth2.googleapis.com/*"],
  "content_scripts": [
    {
      "matches": ["https://calendar.google.com/calendar/*"],
      "js": ["core.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "background": { "service_worker": "background.js" },
  "commands": {
    "insert-hours": {
      "suggested_key": { "default": "Ctrl+Shift+H", "mac": "Command+Shift+H" },
      "description": "Insert or update the duration in the open event"
    }
  },
  "action": {
    "default_title": "Calendar Hours",
    "default_popup": "popup.html"
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
